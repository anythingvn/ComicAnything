<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Jetpack DataStore (reading progress, reader settings, Drive connection hint, saved Drive
         links) stores its files under files/datastore/, not the sharedpref domain. Without the
         second include below, none of it was ever covered by cloud backup or device transfer. -->
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
